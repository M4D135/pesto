<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BgWindow}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="Ajouter ce PC au domaine" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="Un poste, une opération. Choisissez son nom, vérifiez le récapitulatif, puis confirmez." TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,18"/>
        <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="JnRefresh" DockPanel.Dock="Right" Content="Vérifier l’état" HorizontalAlignment="Right" ToolTip="Relire l’état Windows et le reçu de la dernière jonction. Après redémarrage, vérifier aussi le canal sécurisé. Aucune réparation et aucun ajout." AutomationProperties.AutomationId="JnRefresh" AutomationProperties.Name="Vérifier l’état" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Relire l’état Windows et le reçu de la dernière jonction. Après redémarrage, vérifier aussi le canal sécurisé. Aucune réparation et aucun ajout."/>
              <Button x:Name="JnReview" DockPanel.Dock="Right" Content="Vérifier dans AD" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Relire la jonction enregistrée dans Windows et Active Directory, puis confirmer le résultat. Aucun nouvel ajout ni redémarrage." AutomationProperties.Name="Vérifier la jonction après redémarrage" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="Relire la jonction enregistrée dans Windows et Active Directory, puis confirmer le résultat. Aucun nouvel ajout ni redémarrage."/>
              <TextBlock Text="1. Ce PC" FontSize="17" FontWeight="SemiBold"/>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Nom actuel" Foreground="{DynamicResource FgMuted}"/>
              <StackPanel Grid.Row="1"><TextBlock x:Name="JnCurrent" Margin="0,5,0,12" FontSize="16" FontWeight="SemiBold" ToolTip="Nom Windows actif du PC qui exécute Pesto. La jonction ne peut pas viser une machine distante." AutomationProperties.AutomationId="JnCurrent" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Nom Windows actif du PC qui exécute Pesto. La jonction ne peut pas viser une machine distante."/><TextBlock x:Name="JnHardware" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,12"/></StackPanel>
              <TextBlock Grid.Column="2" Text="Domaine cible" Foreground="{DynamicResource FgMuted}"/>
              <TextBlock x:Name="JnDomain" Grid.Column="2" Grid.Row="1" Margin="0,5,0,12" FontSize="16" FontWeight="SemiBold" ToolTip="Domaine cible issu de cfg.json. Ce libellé ne prouve pas encore la joignabilité du domaine." AutomationProperties.AutomationId="JnDomain" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Domaine cible issu de cfg.json. Ce libellé ne prouve pas encore la joignabilité du domaine."/>
              <TextBlock x:Name="JnLocalState" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" AutomationProperties.AutomationId="JnLocalState" ToolTip="État local constaté ou à vérifier. Il ne décrit pas l’inscription Entra du poste." AutomationProperties.HelpText="État local constaté ou à vérifier. Il ne décrit pas l’inscription Entra du poste." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/>
              <TextBlock Grid.Column="2" Grid.Row="2" Text="Compte utilisé pour AD" Foreground="{DynamicResource FgMuted}"/>
              <TextBlock x:Name="JnAccount" Grid.Column="2" Grid.Row="3" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="Compte AD utilisé pour cette demande. Le compte et les droits locaux élevés sont deux contrôles distincts." AutomationProperties.AutomationId="JnAccount" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Compte AD utilisé pour cette demande. Le compte et les droits locaux élevés sont deux contrôles distincts."/>
            </Grid>
            <Button x:Name="JnRename" Content="Ouvrir Renommer / déplacer" Style="{DynamicResource BtnGhost}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed" ToolTip="Ouvrir les opérations sur les postes déjà dans le domaine. Aucun ajout au domaine n’est nécessaire pour ce PC." AutomationProperties.AutomationId="JnRename" AutomationProperties.Name="Ouvrir Renommer / déplacer" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Ouvrir les opérations sur les postes déjà dans le domaine. Aucun ajout au domaine n’est nécessaire pour ce PC."/>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="2. Son nom et son emplacement" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
              <TextBlock x:Name="JnPolicy" TextWrapping="Wrap" Foreground="{DynamicResource FgAccent}" ToolTip="Emplacement imposé par la configuration. Le formulaire ne contourne pas la préproduction." AutomationProperties.AutomationId="JnPolicy" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Emplacement imposé par la configuration. Le formulaire ne contourne pas la préproduction."/>
            </Border>
            <Grid x:Name="JnFields" Tag="ResponsiveFieldPairs" AutomationProperties.AutomationId="JnFields" AutomationProperties.Name="Champs de la demande de jonction">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Label Content="Type de poste" Target="{Binding ElementName=JnType}" Padding="0,0,0,6"/>
              <ComboBox x:Name="JnType" Grid.Row="1" Margin="0,0,0,14" MinHeight="38" ToolTip="Portable génère P ; Fixe génère S ; Virtuel génère V. Vérifiez le type avant l’ajout." AutomationProperties.AutomationId="JnType" AutomationProperties.Name="Type de poste" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Portable génère P ; Fixe génère S ; Virtuel génère V. Vérifiez le type avant l’ajout."/>
              <Label Grid.Column="2" Content="Organisme" Target="{Binding ElementName=JnOrg}" Padding="0,0,0,6"/>
              <ComboBox x:Name="JnOrg" Grid.Row="1" Grid.Column="2" Margin="0,0,0,14" MinHeight="38" ToolTip="Choisir l’organisme pour une jonction directe en production. En transit, PREPROD est imposé." AutomationProperties.AutomationId="JnOrg" AutomationProperties.Name="Organisme" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Choisir l’organisme pour une jonction directe en production. En transit, PREPROD est imposé."/>
              <Label Grid.Row="2" Content="Site" Target="{Binding ElementName=JnSite}" Padding="0,0,0,6"/>
              <ComboBox x:Name="JnSite" Grid.Row="3" Margin="0,0,0,14" MinHeight="38" ToolTip="Le site détermine le code de nommage et l’OU réelle. En préparation, le site est PREPROD." AutomationProperties.AutomationId="JnSite" AutomationProperties.Name="Site" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Le site détermine le code de nommage et l’OU réelle. En préparation, le site est PREPROD."/>
              <Label Grid.Column="2" Grid.Row="2" Content="Service · 3 caractères" Target="{Binding ElementName=JnService}" Padding="0,0,0,6"/>
              <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                <ComboBox x:Name="JnService" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="260" Margin="0" MinHeight="38" ToolTip="Code service sur trois lettres ou chiffres : choisissez un service connu du site ou saisissez-en un nouveau. La valeur de préparation est fixée par PreprodSite." AutomationProperties.AutomationId="JnService" AutomationProperties.Name="Service" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Code service sur trois lettres ou chiffres : choisissez un service connu du site ou saisissez-en un nouveau. La valeur de préparation est fixée par PreprodSite."/>
                <TextBlock x:Name="JnServiceState" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0"/>
              </StackPanel>
              <Label Grid.Row="4" Content="Nouveau nom proposé" Target="{Binding ElementName=JnName}" Padding="0,0,0,6"/>
              <DockPanel Grid.Row="5" LastChildFill="True"><Button x:Name="JnOtherName" Content="Autre nom" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" ToolTip="Choisir un autre candidat libre. Aucune modification du poste." AutomationProperties.Name="Proposer un autre nom" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="Choisir un autre candidat libre. Aucune modification du poste."/><ComboBox x:Name="JnName" DockPanel.Dock="Left" MinHeight="38" MaxDropDownHeight="260" ToolTip="Noms non présents dans le cache et non réservés dans la file. Leur disponibilité réelle sera relue dans AD avant l’ajout." AutomationProperties.AutomationId="JnName" AutomationProperties.Name="Nouveau nom" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Noms non présents dans le cache et non réservés dans la file. Leur disponibilité réelle sera relue dans AD avant l’ajout."/></DockPanel>
            </Grid>
            <Border Background="{DynamicResource BgInputRO}" CornerRadius="10" Padding="15" Margin="0,18,0,0">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="JnCopy" Content="Copier" DockPanel.Dock="Right" Padding="12,5" ToolTip="Copier le nouveau nom proposé. Cela ne renomme pas le PC." AutomationProperties.AutomationId="JnCopy" AutomationProperties.Name="Copier" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Copier le nouveau nom proposé. Cela ne renomme pas le PC."/>
                  <StackPanel><TextBlock Text="APRÈS LA JONCTION" FontSize="10" Foreground="{DynamicResource FgMuted}"/><TextBlock x:Name="JnNamePreview" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.AutomationId="JnNamePreview" ToolTip="Nom proposé dans le brouillon ou enregistré dans le reçu. Vérifier dans AD relit le résultat réel." AutomationProperties.HelpText="Nom proposé dans le brouillon ou enregistré dans le reçu. Vérifier dans AD relit le résultat réel." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/></StackPanel>
                </DockPanel>
                <TextBlock Text="Emplacement demandé dans Active Directory" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,12,0,4"/>
                <TextBlock x:Name="JnOUPreview" TextWrapping="Wrap" AutomationProperties.AutomationId="JnOUPreview"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <CheckBox x:Name="JnExisting" Content="Utiliser un compte ordinateur précréé" Visibility="Collapsed" Margin="8,0,0,14" AutomationProperties.HelpText="Option autorisée par la politique. Le compte doit exister exactement dans l’OU choisie. Aucun changement de propriétaire ni contournement des règles Netjoin." ToolTip="Option autorisée par la politique. Le compte doit exister exactement dans l’OU choisie. Aucun changement de propriétaire ni contournement des règles Netjoin." AutomationProperties.Name="Parcours de compte précréé" ToolTipService.ShowOnDisabled="True"/>
        <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="3. Vérifier et ajouter" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="JnStatus" Text="Prêt à préparer l’ajout" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="JnStatus" AutomationProperties.Name="Résultat de la jonction" ToolTip="Dernier état de la vérification ou de la jonction. Un résultat incertain ne signifie pas que Windows a annulé la commande." AutomationProperties.HelpText="Dernier état de la vérification ou de la jonction. Un résultat incertain ne signifie pas que Windows a annulé la commande." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/>
            <TextBlock x:Name="JnDetail" Text="Aucune action n’a été lancée." Margin="0,8,0,10" TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" AutomationProperties.AutomationId="JnDetail" ToolTip="Explication du résultat et de la prochaine étape. Le journal conserve les informations techniques." AutomationProperties.HelpText="Explication du résultat et de la prochaine étape. Le journal conserve les informations techniques." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/>
            <DataGrid x:Name="JnChecks" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MinHeight="40" MaxHeight="290" SelectionMode="Single" ToolTip="Résultats des lectures préalables. OK signifie que ce contrôle a réussi, pas que la jonction a déjà été exécutée." AutomationProperties.AutomationId="JnChecks" AutomationProperties.Name="Vérifications de la jonction" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Résultats des lectures préalables. OK signifie que ce contrôle a réussi, pas que la jonction a déjà été exécutée.">
              <DataGrid.Columns><DataGridTextColumn Header="Vérification" Binding="{Binding Check}" Width="150"/><DataGridTextColumn Header="État" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,7"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,14,0,0"><Button x:Name="JnLog" Content="Voir le journal" Margin="0,0,8,5" ToolTip="Ouvrir le journal de Pesto pour lire les étapes et les erreurs." AutomationProperties.AutomationId="JnLog" AutomationProperties.Name="Voir le journal" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Ouvrir le journal de Pesto pour lire les étapes et les erreurs."/><Button x:Name="JnExport" Content="Exporter le compte rendu" Margin="0,0,8,5" IsEnabled="False" ToolTip="Exporter le résultat et les contrôles en texte. Aucun credential ni mot de passe. Le fichier contient des informations internes." AutomationProperties.AutomationId="JnExport" AutomationProperties.Name="Exporter le compte rendu" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Exporter le résultat et les contrôles en texte. Aucun credential ni mot de passe. Le fichier contient des informations internes."/></WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="15" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="JnHint" TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,0,0,9" AutomationProperties.AutomationId="JnHint" ToolTip="Motif de disponibilité ou de blocage du bouton principal." AutomationProperties.HelpText="Motif de disponibilité ou de blocage du bouton principal." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/>
        <ProgressBar x:Name="JnProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,7" ToolTip="Une opération est en cours. Cette animation ne constitue pas une estimation de temps restant." AutomationProperties.AutomationId="JnProgress" AutomationProperties.Name="Progression de la jonction" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Une opération est en cours. Cette animation ne constitue pas une estimation de temps restant."/>
        <TextBlock x:Name="JnActivity" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}" AutomationProperties.AutomationId="JnActivity" ToolTip="Étape réellement publiée par le worker et durée écoulée. Ce n’est pas une estimation du temps restant." AutomationProperties.HelpText="Étape réellement publiée par le worker et durée écoulée. Ce n’est pas une estimation du temps restant." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="JnCancelRead" Content="Annuler la vérification" Visibility="Collapsed" Margin="0,0,8,4" ToolTip="Annuler une lecture préalable sans fermer Pesto. Ne coupe jamais une jonction Windows déjà lancée." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.Name="Annuler la vérification" AutomationProperties.AutomationId="JnCancelRead" AutomationProperties.HelpText="Annuler une lecture préalable sans fermer Pesto. Ne coupe jamais une jonction Windows déjà lancée."/><Button x:Name="JnCheck" Content="Vérifier sans ajouter" Margin="0,0,8,4" ToolTip="Relire le PC, le domaine, l’OU et le nom sans lancer Add-Computer. Les vérifications d’écriture restent celles de Windows." AutomationProperties.AutomationId="JnCheck" AutomationProperties.Name="Vérifier sans ajouter" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Relire le PC, le domaine, l’OU et le nom sans lancer Add-Computer. Les vérifications d’écriture restent celles de Windows."/>
          <Button x:Name="JnStart" Content="Ajouter ce PC au domaine" Style="{DynamicResource BtnRun}" Margin="0,0,0,4" ToolTip="Vérifier, confirmer puis joindre uniquement ce PC. Aucun ajout à la file et aucun redémarrage automatique." AutomationProperties.AutomationId="JnStart" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Vérifier, confirmer puis joindre uniquement ce PC. Aucun ajout à la file et aucun redémarrage automatique."/>
          <Button x:Name="JnLater" Content="Plus tard" Margin="8,0,0,4" Visibility="Collapsed" ToolTip="Reporter le redémarrage. Le reçu reste enregistré et bloque une seconde jonction." AutomationProperties.AutomationId="JnLater" AutomationProperties.Name="Plus tard" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Reporter le redémarrage. Le reçu reste enregistré et bloque une seconde jonction."/>
          <Button x:Name="JnRestart" Content="Redémarrer maintenant" Margin="8,0,0,4" Style="{DynamicResource BtnRun}" Visibility="Collapsed" ToolTip="Demander explicitement le redémarrage du PC après confirmation. Enregistrez votre travail ; aucun redémarrage forcé." AutomationProperties.AutomationId="JnRestart" AutomationProperties.Name="Redémarrer maintenant" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Demander explicitement le redémarrage du PC après confirmation. Enregistrez votre travail ; aucun redémarrage forcé."/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>