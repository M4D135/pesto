+function Invoke-GPBulkPrepare {
+    param($Sender,$EventArgs)
+    $s=$Sender.Tag;$s.Apply.IsEnabled=$false;$s.Candidate=$null;$s.Preview.ItemsSource=$null
+    try {
+        $names=@(ConvertFrom-GPComputerList -Text $s.Sources.Text)
