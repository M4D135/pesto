+$script:GPPreflightWorker={
+    param($Request,$Source)
+    Set-StrictMode -Off;$ErrorActionPreference='Stop'
+    . ([scriptblock]::Create([string]$Source))
+    if(-not(Get-Module ActiveDirectory -ErrorAction SilentlyContinue)) {
+        if(Get-Module -ListAvailable ActiveDirectory -ErrorAction SilentlyContinue){Import-Module ActiveDirectory -ErrorAction Stop -WarningAction SilentlyContinue}
+        elseif($Request.ADModulePath -and(Test-Path -LiteralPath $Request.ADModulePath)){Import-Module $Request.ADModulePath -ErrorAction Stop -WarningAction SilentlyContinue}
+        else{throw 'Module AD absent. Aucun contrôle effectué.'}
+    }
+    $script:INDOMAIN=[bool]$Request.InDomain;$script:OU=$Request.OU;$script:OUV=$Request.OUSite
+    $script:PREFIXE=[string]$Request.Prefix
+    $results=[Collections.Generic.List[object]]::new();$ouCache=@{}
+    foreach($item in $Request.Items) {
+        $Request.Progress.Current=[string]$item.Nom_du_PC
+        $result=Invoke-GPReadOnlyPreflight -Item $item -Request $Request -OUCache $ouCache
+        $results.Add($result);$Request.Progress.Done=$results.Count
+    }
+    [pscustomobject]@{Results=$results.ToArray()}
+}
