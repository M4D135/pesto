</Style>
<!-- RC7 : WPF transmet deja Control.Padding au ScrollViewer PART_ContentHost.
     Ne pas ajouter ce Padding une seconde fois comme Margin ou sur le Border :
     cela reduit la zone de texte et coupe les caracteres (ainsi que le mot de passe). -->
<Style TargetType="TextBox">
 <Setter Property="Background" Value="{DynamicResource BgInput}"/><Setter Property="Foreground" Value="{DynamicResource FgText}"/><Setter Property="CaretBrush" Value="{DynamicResource FgText}"/>
 <Setter Property="BorderBrush" Value="{DynamicResource ClrBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="36"/>
 <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="SelectionBrush" Value="{DynamicResource RowSelBg}"/>
 <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/><Setter Property="ToolTipService.ShowDuration" Value="30000"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextChrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers>
  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TextChrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextChrome" Property="Opacity" Value="0.6"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource BgInput}"/><Setter Property="Foreground" Value="{DynamicResource FgText}"/><Setter Property="CaretBrush" Value="{DynamicResource FgText}"/><Setter Property="BorderBrush" Value="{DynamicResource ClrBorder}"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="PasswordChrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordChrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox">
 <Setter Property="Foreground" Value="{DynamicResource FgText}"/><Setter Property="Margin" Value="0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
 <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/><Setter Property="ToolTipService.ShowDuration" Value="30000"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="CheckChrome" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="CheckMark" Visibility="Collapsed" Data="M 3 8 L 6.5 11 L 12.5 4.5" Stroke="{DynamicResource RunFg}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
  <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
 </Grid><ControlTemplate.Triggers>
  <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AddBg}"/><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AddBg}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
