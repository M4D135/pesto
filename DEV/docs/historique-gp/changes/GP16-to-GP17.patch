+function Save-GPQueueCheckpoint {
+    param([string]$Phase='Idle')
+    if ($script:GUI -or $script:SIM) { return }
+    if($script:MutationUncertain){$Phase='Uncertain'}
+    $rows=@(foreach($r in @($script:table.Rows)) {
+        $obj=[ordered]@{}
+        foreach($col in $script:table.Columns){$v=$r[$col.ColumnName];$obj[$col.ColumnName]=if($v -is [DBNull]){$null}else{$v}}
+        [pscustomobject]$obj
+    })
+    $data=[ordered]@{Schema=1;Version=$script:GP_VERSION;Domain=$script:DOMAINE;Host=$env:COMPUTERNAME;Mode='REEL';Phase=$Phase;Utc=[DateTime]::UtcNow.ToString('o');Rows=$rows}
+    Write-GPAtomicText -Path (Join-Path (Get-GPStateDirectory) 'queue.json') -Text ($data|ConvertTo-Json -Depth 8)
+}
