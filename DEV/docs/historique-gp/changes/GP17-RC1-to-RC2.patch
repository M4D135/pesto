--- /dev/null
+++ RC2/GP.ps1
@@ -0,0 +1,35 @@
+#requires -Version 5.1
+[CmdletBinding()]
+param([switch]$Demo,[string]$ConfigPath)
+# Point d'entree GP. Le moteur et ses ressources restent dans wad.
+# Ce lanceur peut etre execute en PS1 ou compile en EXE x64/STA.
+$ErrorActionPreference='Stop'
+$root=$null
+try {
+    if($env:OS -ne 'Windows_NT'){throw 'GP necessite Windows PowerShell 5.1 x64 sous Windows.'}
+    if($PSVersionTable.PSEdition -ne 'Desktop' -or $PSVersionTable.PSVersion.Major -ne 5){throw 'Utiliser Windows PowerShell 5.1 (powershell.exe), pas pwsh.'}
+    if(-not [Environment]::Is64BitProcess){throw 'Un processus PowerShell 64 bits est requis. Utiliser GP.cmd.'}
+    if([Threading.Thread]::CurrentThread.ApartmentState -ne 'STA'){throw 'Un thread STA est requis. Utiliser GP.cmd ou powershell.exe -STA.'}
+    $root=if($PSScriptRoot){$PSScriptRoot}else{[IO.Path]::GetDirectoryName([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)}
+    $core=Join-Path $root 'wad\GP-Core.ps1'
+    if(-not (Test-Path -LiteralPath $core -PathType Leaf)){throw "Moteur absent : $core. Extraire toute l'archive ; conserver wad a cote du lanceur."}
+    $parameters=@{Demo=$Demo.IsPresent}
+    if($PSBoundParameters.ContainsKey('ConfigPath')){
+        if([string]::IsNullOrWhiteSpace($ConfigPath)){throw 'Le parametre ConfigPath ne peut pas etre vide.'}
+        # Resoudre avant le changement de portee, relativement au dossier appelant.
+        $parameters.ConfigPath=$ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($ConfigPath)
+    }
+    & $core @parameters
+    # Le moteur termine par Quit : transmettre son code au CMD ou au lanceur EXE.
+    exit $LASTEXITCODE
+} catch {
+    $message="GP n'a pas pu demarrer.`r`n`r`n$($_.Exception.Message)`r`n`r`nApres extraction, utiliser DEBLOQUER_TOUT.cmd puis GP.cmd. Ne pas contourner une restriction imposee par votre organisation."
+    if($root){
+        try { ([DateTime]::Now.ToString('s')+"`r`n"+$_.Exception.ToString()) | Set-Content -LiteralPath (Join-Path $root 'GP-demarrage.log') -Encoding UTF8 -ErrorAction Stop } catch {}
+    }
+    try {
+        Add-Type -AssemblyName PresentationFramework -ErrorAction Stop
+        [Windows.MessageBox]::Show($message,'GP - demarrage impossible','OK','Error') | Out-Null
+    } catch { Write-Host $message }
+    exit 1
+}
