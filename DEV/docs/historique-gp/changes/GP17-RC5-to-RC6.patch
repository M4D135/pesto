+function Initialize-GPUx {
+    if($script:GPUxReady){return}
+    $script:GPUxTimer=[Windows.Threading.DispatcherTimer]::new()
+    $script:GPUxTimer.Interval=[TimeSpan]::FromMilliseconds(90)
+    $script:GPUxTimer.Add_Tick([EventHandler]${function:Invoke-GPUxRefreshTick})
+    $script:GPUxLookupTimer=[Windows.Threading.DispatcherTimer]::new()
+    $script:GPUxLookupTimer.Interval=[TimeSpan]::FromMilliseconds(350)
+    $script:GPUxLookupTimer.Add_Tick([EventHandler]${function:Invoke-GPUxComputerLookupTick})
+    foreach($n in @('NavHome','NavRename','NavNames','NavHistory','NavLogs','NavSettings','NavHelp','BtnHelp','BtnInlineHelp','HomePrepare','HomeQueue','HomeNames','HomeHistory')){
+        $Win.FindName($n).Add_Click([Windows.RoutedEventHandler]${function:Invoke-GPUxNavigate})
+    }
