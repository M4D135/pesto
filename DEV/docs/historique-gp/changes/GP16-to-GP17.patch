+function Reset-GPSafetyLock {
+    if($script:Running -or -not $script:MutationUncertain){return}
+    $msg="Ce verrou signale une mutation incertaine, un défaut de protection ou une erreur technique.`n`nAvant de continuer, contrôlez les postes concernés dans AD, le nom local, les éventuelles tâches GP_ et la protection anti-suppression. Une tâche distante peut encore travailler.`n`nConfirmez-vous avoir vérifié l'état réel et terminé les actions résiduelles ? Les lignes incertaines resteront décochées."
+    if([Windows.MessageBox]::Show($msg,'Vérification manuelle obligatoire','YesNo','Warning','No') -ne 'Yes'){return}
+    $script:MutationUncertain=$false
+    foreach($r in @($script:table.Rows|Where-Object{$_.Statut -in @('INCERTAIN','TECHNIQUE','PROTECTION','EN COURS')})){$r.Traiter=$false}
+    Write-AuditLine 'Verrou levé par confirmation MANUELLE de l''opérateur ; aucune validation automatique de l''AD.' 'warn'
+    Save-GPQueueCheckpointSafe -Phase 'Reviewed';Update-QueueButtons;Update-AddButton
+}
