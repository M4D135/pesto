 # Les opérations réseau/AD ne doivent jamais tourner sur le Dispatcher WPF.
-# Chaque opération possède son runspace MTA ; seul le résultat final revient sur
-# le Dispatcher. Les callbacks sont validés et encapsulés : une erreur dans un
+# Les lectures utilisent MTA ; QueueAction utilise STA pour l'élévation locale.
+# Les étapes transitent en mémoire partagée, les callbacks restent sur le Dispatcher. Les callbacks sont validés et encapsulés : une erreur dans un
 # callback ne doit jamais faire tomber tout GP.
 $script:GPAsyncOperations = @{}
 $script:GPAsyncTimerOperations = @{}
+
+
+# RC9 : messages en mémoire partagée. Le worker ne touche jamais un objet WPF.
+function New-GPQueueMonitor {
+    param([string]$Computer)
+    return [hashtable]::Synchronized(@{
+        Computer=$Computer; Events=[Collections.Concurrent.ConcurrentQueue[object]]::new()
+        Stage=[pscustomobject]@{Name='Préparation du worker';Started=[DateTime]::UtcNow;Detail=''}
+        CancelRequested=$false; MutationStarted=$false; TimedOut=$false; HelperPid=0
+        LastHeartbeat=[DateTime]::UtcNow
+    })
+}
+
+function Publish-GPWorkerLog {
+    param([string]$Text,[string]$Level='INFO',[string]$Context='worker')
+    if($null -eq $script:GPQueueMonitor){return}
+    $event=[pscustomobject]@{Time=[DateTime]::UtcNow;Text=(Protect-GPLogText $Text);Level=$Level;Context=$Context}
+    $script:GPQueueMonitor.Events.Enqueue($event)
+}
+
+function Set-GPWorkerStage {
+    param([string]$Name,[string]$Detail='')
+    if($null -eq $script:GPQueueMonitor){return}
+    $script:GPQueueMonitor.Stage=[pscustomobject]@{Name=$Name;Started=[DateTime]::UtcNow;Detail=$Detail}
+    Publish-GPWorkerLog -Text ($Name+$(if($Detail){' : '+$Detail}else{''})) -Context 'étape'
+}
+
+function Assert-GPWorkerMayContinue {
+    <# Barrière coopérative, distincte de Stop(). Une commande Windows déjà
+       entrée peut encore agir ; elle n'est jamais annoncée comme annulée. #>
+    param([switch]$Mutation)
+    $m=$script:GPQueueMonitor
+    if($null -eq $m){return} # Fonctions isolées / tests historiques.
+    [Threading.Monitor]::Enter($m.SyncRoot)
+    try {
+        if($m.CancelRequested){throw [OperationCanceledException]::new('Surveillance expirée : aucune nouvelle étape de mutation autorisée. Vérification manuelle requise.')}
+        if($Mutation){$m.MutationStarted=$true}
+    } finally {[Threading.Monitor]::Exit($m.SyncRoot)}
+}
+
+function Set-GPQueueCancellationFence {
+    param([AllowNull()]$Monitor)
+    if($null -eq $Monitor){return}
+    [Threading.Monitor]::Enter($Monitor.SyncRoot)
+    try {$Monitor.CancelRequested=$true;$Monitor.TimedOut=$true}
+    finally {[Threading.Monitor]::Exit($Monitor.SyncRoot)}
+}
+
+function Receive-GPQueueEvents {
+    <# Appel Dispatcher uniquement. Drain borné : pas de Wait/Invoke synchrone. #>
+    param([AllowNull()]$Monitor,[int]$Maximum=200)
+    if($null -eq $Monitor){return}
+    $event=$null;$read=0
+    while($read -lt $Maximum -and $Monitor.Events.TryDequeue([ref]$event)){
+        $kind=if($event.Level -match 'ERR|FATAL'){'err'}elseif($event.Level -match 'WARN'){'warn'}else{'info'}
+        $text='[{0}] {1} | {2} : {3}' -f $event.Time.ToLocalTime().ToString('HH:mm:ss'),$Monitor.Computer,$event.Context,$event.Text
+        Add-LogLine $text $kind
+        $read++;$event=$null
+    }
+}
+
+function Get-GPQueueActivityText {
+    param([AllowNull()]$Monitor)
+    if($null -eq $Monitor){return ''}
+    $stage=$Monitor.Stage
+    $seconds=[Math]::Max(0,[int]([DateTime]::UtcNow-$stage.Started).TotalSeconds)
+    $text='{0} | {1} s dans cette étape' -f $stage.Name,$seconds
+    if($stage.Detail){$text+=' | '+[string]$stage.Detail}
+    if([int]$Monitor.HelperPid -gt 0){$text+=' | helper PID '+[int]$Monitor.HelperPid}
+    return $text
+}
+
+function Test-GPQueueWorkerStillActive {
+    foreach($op in @($script:GPAsyncTimerOperations.Values)){
+        if($op.Name -eq 'QueueAction' -and $op.Async -and -not $op.Async.IsCompleted){return $true}
+    }
+    return $false
+}
 
