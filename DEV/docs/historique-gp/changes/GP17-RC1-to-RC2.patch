+++ RC2/GP.cmd
@@ -0,0 +1,25 @@
+@echo off
+setlocal EnableExtensions DisableDelayedExpansion
+title GP - Gestion des Postes
+set "GP_PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
+if exist "%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "GP_PS=%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
+if not exist "%GP_PS%" (
+    echo ERREUR : Windows PowerShell x64 introuvable.
+    pause
+    exit /b 1
+)
+if not exist "%~dp0wad\GP-Core.ps1" (
+    echo ERREUR : wad\GP-Core.ps1 absent. Extraire tout le dossier GP.
+    pause
+    exit /b 1
+)
+rem RemoteSigned ne concerne que ce processus ; les GPO restent prioritaires.
+"%GP_PS%" -NoLogo -NoProfile -STA -ExecutionPolicy RemoteSigned -File "%~dp0GP.ps1" %*
+set "GP_EXIT_CODE=%ERRORLEVEL%"
+if not "%GP_EXIT_CODE%"=="0" (
+    echo.
+    echo GP a signale une erreur. Consulter le message et GP-demarrage.log si present.
+    echo Apres extraction, executer DEBLOQUER_TOUT.cmd avant de relancer GP.
+    pause
+)
+exit /b %GP_EXIT_CODE%
