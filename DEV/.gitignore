# Configuration réelle / état / livrables : ne pas publier de données internes.
cfg.json
cfg.original.json
logs/
dist/
*.bak
*.log
*.exe
# Exception assumee : Pesto.exe. Sans lui, un clone neuf ne peut pas lancer le
# verificateur d'integrite (les empreintes des composants sont embarquees dans le
# binaire). Il est reconstruit par tools/launcher/build_native.py puis controle par
# tools/refresh_manifest.py --check ; les autres .exe restent exclus.
!Pesto.exe
__pycache__/
*.pyc
tests/windows-test-results.json
# Le rapport statique livré contient les domaines de la configuration privée.
tests/static-report.json

tests/windows-package-results.json

# RC6: donnees generees localement
wad/gp.prefs.json
tests/windows-*-results.json
tests/ux-static-report.json
tests/ux-checker-selftest-report.json

# Rapports des controleurs statiques : regeneres a chaque execution et porteurs des
# domaines de la configuration privee (même raison que tests/static-report.json plus
# haut). Les copies faisant foi restent suivies dans
# docs/historique-gp/docs/validation-historique/.
tests/*static-report.json
tests/*checker-selftest-report.json

# Résultats de tests générés par run_tests.py (ne jamais commit)
tests/results/
