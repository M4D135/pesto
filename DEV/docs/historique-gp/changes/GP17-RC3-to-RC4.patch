+function Complete-GPQueueNotStarted {
+    <# Appelee UNIQUEMENT avant Start-GPAsyncOperation : aucune mutation de cette ligne
+       n'a pu etre emise. Arrete la file sans inventer un etat AD incertain. #>
+    param($Failure)
+    $ticket=$script:QueueCurrentTicket;$st=$script:QueueRunState
+    if(-not $ticket -or -not $st -or $ticket.Completed){return}
+    $ticket.Completed=$true
+    $detail=Protect-GPLogText "Action NON LANCEE : precontrole local impossible. $($Failure.Exception.Message) Aucun appel de renommage/deplacement n'a ete emis pour ce poste."
+    Write-Log 'Precontrole local echoue avant lancement du worker.' 'ERROR' $Failure 'checkpoint'
+    Set-GPQueueRowResult -Row $ticket.Item.Row -Code 96 -Message $detail -Duration ((Get-Date)-$ticket.Started).TotalSeconds
+    $st.CancelCount++
+    for($i=[int]$st.Index;$i -lt $st.Items.Count;$i++) {
+        Set-GPQueueRowResult -Row $st.Items[$i].Row -Code 96 -Message 'File arretee avant lancement : precontrole local en echec sur la ligne precedente.' -Duration 0
+        $st.CancelCount++
+    }
+    $st.Index=$st.Items.Count;$script:QueueCurrentTicket=$null
+    Add-LogLine $detail 'err';Write-AuditLine $detail 'err'
+    Sync-Grid
+    Complete-GPQueueRun
 }
 
