+function Get-GPPreflightSource {
+    $names=@('Test-GPDnsName','Split-GPDistinguishedName','Get-GPParentDN','Get-GPDomainFromDN','Test-GPDNWithinScope',
+        'Test-GPComputerName','Test-GPGeneratedComputerName','Test-GPOUPath','Test-GPOUInConfiguredScope',
+        'Get-GPNameSiteCode','Get-GPSiteContainerDN','Get-GPRenameMoveDecision','Get-GPIdentityChangeReason',
+        'Test-QueueRowSafe','Protect-GPLogText','Invoke-GPReadOnlyPreflight')
+    $sb=[Text.StringBuilder]::new()
+    foreach($n in $names){$fn=Get-Command $n -CommandType Function -ErrorAction Stop;[void]$sb.AppendLine("function $n {");[void]$sb.AppendLine($fn.Definition);[void]$sb.AppendLine('}')}
+    return $sb.ToString()
+}
