<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="vendor" value="vendor/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="vendor"><package pattern="Microsoft.Web.WebView2" /><package pattern="System.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="Microsoft.NETCore.App.*" /><package pattern="Microsoft.WindowsDesktop.App.*" /><package pattern="Microsoft.NET.ILLink.Tasks" /><package pattern="Microsoft.AspNetCore.App.*" /></packageSource>
  </packageSourceMapping>
</configuration>
