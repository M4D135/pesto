+    try{Update-GPUx; $script:GPUxRenderError=$false}
+    catch{
+        if(-not $script:GPUxRenderError){Write-Log 'Aperçu RC6 non actualisé. Les validations du moteur restent actives.' 'ERROR' $_ 'interface';$script:GPUxRenderError=$true}
+        if($UxNextStep){$UxNextStep.Text='L''aperçu n''a pas pu être actualisé. Consultez Journal avant de continuer.'}
+    }
+}
