+function Prepare-GPMoveRetry {
+    if($script:Running -or $script:MutationUncertain){return}
+    $view=$Grid.SelectedItem;if(-not $view -or [string]$view.Code -ne '89'){return}
+    $r=$view.Row
+    if([Windows.MessageBox]::Show("Préparer un déplacement seul de '$($r.Nouveau_Nom)' vers l'OU prévue ?`nLe renommage ne sera PAS rejoué. La file ne sera pas lancée automatiquement.",'Reprendre uniquement le déplacement','YesNo','Question','No') -ne 'Yes'){return}
+    $r.Nom_du_PC=$r.Nouveau_Nom;$r.Renommer=$false;$r.Deplacer=$true;$r.Reboot=$false
+    $r.Statut='';$r.Code='';$r.Message='Déplacement seul préparé après renommage confirmé (ancien code 89).'
+    $r.Duree='';$r.Horodatage='';$r.Traiter=$true
+    Write-AuditLine "Reprise déplacement seul préparée pour '$($r.Nom_du_PC)' ; renommage exclu." 'info'
+    Save-GPQueueCheckpointSafe;Sync-Grid;Update-QueueButtons
+}
