+function Complete-GPDirectoryRefresh {
+    param([AllowNull()]$Snapshot,[bool]$LockMain,[AllowNull()]$Failure)
+    try {
+        if($Failure){throw $Failure.Exception}
+        if(-not $Snapshot -or -not $Snapshot.DC){throw 'Snapshot AD absent ou incomplet.'}
+        # Fonction nommée liée au script GP, et non au module privé GetNewClosure.
+        $script:DC=[string]$Snapshot.DC;$script:Sites=$Snapshot.Sites
+        $script:Computers=@($Snapshot.Root);$script:ComputersNoms=@($Snapshot.Names);$script:NmUsedSrc=$null
+        if($Snapshot.LocalComputer){$script:LocalComputerSnapshot=$Snapshot.LocalComputer}
+        Update-GPComputerIndex;Build-NmIndex;Populate-NmFilters;Update-NameGrid
+        $msg="Annuaire actualisé : $(@($script:ComputersNoms).Count) noms / $(@($script:Computers).Count) postes."
+        Add-LogLine $msg 'info';$LblStatus.Text=$msg
+    }catch{
+        $msg="Rafraîchissement AD échoué : $($_.Exception.Message)"
+        Add-LogLine $msg 'err';Write-Log $msg 'ERROR' $_ 'AD';$LblStatus.Text=$msg
+    }finally{
+        if($NmBtnRefresh){$NmBtnRefresh.IsEnabled=-not $script:Running}
+        if($LockMain -and -not $script:Running){
+            $CbOrg.IsEnabled=$true
+            try{if("$($CbOrg.SelectedItem)".Trim()){Apply-OrganismeSelection}else{Update-AddButton}}catch{}
+        }
+        Update-QueueButtons;Update-AddButton
+    }
+}
