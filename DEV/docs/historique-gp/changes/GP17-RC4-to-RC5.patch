+        $s.Status.Text="$($s.Candidate.Rows.Count) renommage(s), $moves déplacement(s). 0 redémarrage. Noms réservés dans ce plan uniquement."
+        $s.Apply.IsEnabled=$true
+    }catch{$s.Status.Text=$_.Exception.Message}
