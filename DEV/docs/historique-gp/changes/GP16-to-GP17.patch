+  <TextBox Grid.Row="2" x:Name="Json" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" Background="#1F2937" Foreground="#F9FAFB" Padding="10"/>
+  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="Save" Content="Valider, sauvegarder et continuer" Padding="18,9" Margin="0,0,10,0"/><Button Content="Quitter" IsCancel="True" Padding="18,9"/></StackPanel>
+ </Grid>
+</Window>
+'@
+    $w=[Windows.Markup.XamlReader]::Load([Xml.XmlNodeReader]::new($cx))
