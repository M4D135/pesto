+function Request-GPUxComputerLookup {
+    <# Invalider l'ancienne identité immédiatement ; temporiser uniquement la lecture.
+       Important : aucun intervalle ne permet d'ajouter l'ancien plan au nouveau nom. #>
+    if($script:Suspend){return}
+    if(-not $script:GPUxReady){Select-PCName;return}
+    if($script:Running -or $script:PreflightRunning){return}
+    $script:GPUxLookupTimer.Stop()
+    $script:PCProbeGeneration=[int]$script:PCProbeGeneration+1
+    if(Test-GPAsyncOperationRunning 'PCProbe'){Stop-GPAsyncOperation 'PCProbe'}
+    Reset-ConfigFields -KeepName
+    $script:PING=$null;Update-FieldColor
+    $BtnAdd.IsEnabled=$false
+    if(Test-GPComputerName ([string]$TxtPCName.Text)){
+        $script:GPUxLookupName=([string]$TxtPCName.Text).Trim().ToUpperInvariant()
+        $script:GPUxLookupEditIndex=[int]$script:EDIT_ROW_INDEX
+        $script:GPUxLookupLocal=[bool]$script:LOCALHOST
+        $script:GPUxLookupTimer.Start()
+    }
+    Request-GPUxRefresh
+}
+function Invoke-GPUxComputerLookupTick {
+    param($Sender,$EventArgs)
+    $Sender.Stop()
+    # Un changement de mode ou l'ouverture d'une autre ligne pendant les 350 ms
+    # ne doit jamais être écrasé par une ancienne demande de lecture.
+    $sameContext=($script:GPUxLookupName -ceq ([string]$TxtPCName.Text).Trim().ToUpperInvariant() -and
+        $script:GPUxLookupEditIndex -eq [int]$script:EDIT_ROW_INDEX -and
+        $script:GPUxLookupLocal -eq [bool]$script:LOCALHOST)
+    if($sameContext -and -not $script:Running -and -not $script:PreflightRunning){Select-PCName}
+    Request-GPUxRefresh
+}
+function Invoke-GPUxReadComputer {
+    param($Sender,$EventArgs)
+    if($script:Running -or $script:PreflightRunning -or $script:MutationUncertain -or $script:CfgRestartRequired){return}
+    if($script:GPUxLookupTimer){$script:GPUxLookupTimer.Stop()}
+    Select-PCName
+    Request-GPUxRefresh
+}
+function Invoke-GPUxSourceKey {
+    param($Sender,$EventArgs)
+    if($EventArgs.Key -eq [Windows.Input.Key]::Return){$EventArgs.Handled=$true;Invoke-GPUxReadComputer $Sender $EventArgs}
+}
+function Invoke-GPUxKey {
+    param($Sender,$EventArgs)
+    if($EventArgs.Handled){return}
+    $ctrl=([Windows.Input.Keyboard]::Modifiers -band [Windows.Input.ModifierKeys]::Control)
+    if($EventArgs.Key -eq [Windows.Input.Key]::F1){
+        $EventArgs.Handled=$true;$focused=[Windows.Input.Keyboard]::FocusedElement
+        $text=if($focused -and $focused -is [Windows.FrameworkElement]){[string]$focused.ToolTip}else{''}
+        if($focused -is [Windows.Controls.TextBox] -and $focused.Name -eq 'PART_EditableTextBox'){
+            $parent=[Windows.Controls.ItemsControl]::ItemsControlFromItemContainer($focused)
+            if(-not $parent){$parent=$focused.TemplatedParent}
+            if($parent -is [Windows.Controls.ComboBox]){$text=[string]$parent.ToolTip}
+        }
+        if($text){Show-GPTextReport 'Aide du contrôle actif' $text}else{Set-GPUxPage 'Help'}
+    }elseif($ctrl){
+        switch($EventArgs.Key){
+            'D1' {Set-GPUxPage 'Rename';$EventArgs.Handled=$true}
+            'D2' {Set-GPUxPage 'Names';$EventArgs.Handled=$true}
+            'D3' {Set-GPUxPage 'Log';$EventArgs.Handled=$true}
+        }
+    }
+}
