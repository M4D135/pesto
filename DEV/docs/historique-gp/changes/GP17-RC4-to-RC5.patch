+###############################################################################
+#  GP RC5 : planification, contrôles en lecture seule et bilans
+#  Ces fonctions sont extraites par liste blanche dans les tests et les workers.
+###############################################################################
+function Get-GPRowPlanText {
+    param($Row,[bool]$InDomain=$true)
+    $text=if(-not $InDomain){'JOINDRE'}elseif($Row.Renommer -and $Row.Deplacer){'RENOMMER > DÉPLACER'}elseif($Row.Renommer){'RENOMMER SEUL'}elseif($Row.Deplacer){'DÉPLACER SEUL'}else{'AUCUNE ACTION'}
+    if($Row.Reboot){$text+=' > REDÉMARRAGE'}
+    return $text
+}
+
+function Get-GPPlanSignature {
+    param($Row,[string]$Domain=$script:DOMAINE,[string]$Server=$script:DC)
+    # Empreinte de données, jamais de credential. Le mode et la politique de
+    # protection font partie du contexte ; un contrôle ne traverse pas les modes.
+    $data=@([string]$Domain,[string]$Server,[bool]$script:INDOMAIN,[bool]$script:PRD,
+        [bool]$script:GUI,[bool]$script:SIM,[bool]$script:CLEAR_PROTECTION,
+        [string]$script:OU['PREPROD'],[string]$script:OU['ROOT'],[string]$script:PREFIXE,[string]$Row.Nom_du_PC,[string]$Row.Nouveau_Nom,
+        [string]$Row.OU_Actuelle,[string]$Row.OU_Destination,[bool]$Row.Renommer,
+        [bool]$Row.Deplacer,[bool]$Row.Reboot,[string]$Row.Objet_GUID)
+    $json=ConvertTo-Json -InputObject $data -Compress -Depth 3
+    $sha=[Security.Cryptography.SHA256]::Create()
+    try{return ([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($json)))).Replace('-','')}
+    finally{$sha.Dispose()}
+}
+
+function Get-GPIdentityChangeReason {
+    param([string]$ExpectedGuid,[string]$ActualGuid,[string]$ExpectedOU,[string]$ActualOU)
+    if($ExpectedGuid) {
+        $a=[Guid]::Empty;$b=[Guid]::Empty
+        if(-not [Guid]::TryParse($ExpectedGuid,[ref]$a) -or $a -eq [Guid]::Empty){return 'GUID préparé invalide : relisez le poste.'}
+        if(-not [Guid]::TryParse($ActualGuid,[ref]$b) -or $b -eq [Guid]::Empty -or $a -ne $b){return 'L''objet AD ne correspond plus au GUID préparé : aucune mutation autorisée.'}
+    }
+    if($ExpectedOU -and (Test-GPOUPath $ExpectedOU)) {
+        if(-not(Test-GPOUPath $ActualOU)){return 'OU source réelle illisible : aucune mutation autorisée.'}
+        $a=@(Split-GPDistinguishedName $ExpectedOU) -join ','
+        $b=@(Split-GPDistinguishedName $ActualOU) -join ','
+        if($a -ine $b){return "Le poste a changé d'OU depuis la préparation. Attendue : '$ExpectedOU'. Observée : '$ActualOU'. Relisez le poste et recréez la ligne."}
+    }
+    return ''
+}
+
+function ConvertTo-GPFilterLiteral {
+    param([AllowEmptyString()][string]$Text)
+    # RowFilter LIKE possède sa propre grammaire. Échapper caractère par
+    # caractère évite de rééchapper les crochets ajoutés à l'étape précédente.
+    $sb=[Text.StringBuilder]::new()
+    foreach($c in $Text.ToCharArray()) {
+        switch($c) {
+            "'" {[void]$sb.Append("''")}
+            '[' {[void]$sb.Append('[[]')}
+            ']' {[void]$sb.Append('[]]')}
+            '*' {[void]$sb.Append('[*]')}
+            '%' {[void]$sb.Append('[%]')}
+            default {[void]$sb.Append($c)}
+        }
+    }
+    return $sb.ToString()
+}
+
+function Get-GPQueueFilterExpression {
+    param([string]$Search,[string]$Filter='Toute la file')
+    $clauses=[Collections.Generic.List[string]]::new()
+    switch($Filter) {
+        'À traiter' {$clauses.Add('[Traiter] = true')}
+        'À contrôler' {$clauses.Add("[Statut] IN ('','KO','ANNULÉ','NON LANCÉ') AND NOT ([Precontrole] IN ('VÉRIFIÉ','AVERTISSEMENT','DÉMO'))")}
+        'À examiner' {$clauses.Add("([Statut] IN ('KO','PARTIEL','PROTECTION','INCERTAIN','TECHNIQUE') OR [Precontrole] = 'BLOQUÉ')")}
+        'Réussites réelles' {$clauses.Add("[Statut] = 'OK' AND [Mode_Resultat] = 'RÉEL'")}
+        'Simulations' {$clauses.Add("[Statut] = 'SIMULÉ'")}
+        'Toute la file' {}
+        default {throw 'Filtre de file inconnu.'}
+    }
+    $term="$Search".Trim()
+    if($term.Length -gt 128){$term=$term.Substring(0,128)}
+    if($term) {
+        $escaped=ConvertTo-GPFilterLiteral $term
+        $parts=@(foreach($col in @('Nom_du_PC','Nouveau_Nom','Site','Service','Organisme','Reference','Message')) {"[$col] LIKE '%$escaped%'"})
+        $clauses.Add('('+($parts -join ' OR ')+')')
+    }
+    return (@($clauses.ToArray()|ForEach-Object{'('+$_+')'}) -join ' AND ')
+}
+
+function ConvertFrom-GPComputerList {
+    param([Parameter(Mandatory)][AllowEmptyString()][string]$Text)
+    if($Text.Length -gt 65536){throw 'Liste trop volumineuse (64 K caractères maximum).'}
+    $list=[Collections.Generic.List[string]]::new();$seen=@{}
+    foreach($token in ($Text -split '[\s,;]+')) {
+        $name=$token.Trim().ToUpperInvariant();if(-not $name){continue}
+        if(-not(Test-GPComputerName $name)){throw "Nom de poste invalide : '$name'. Uniquement les noms courts, pas les FQDN, les commandes ni les colonnes CSV."}
+        if($seen.ContainsKey($name)){throw "Doublon dans la liste : '$name'. La file n'a pas été modifiée."}
+        $seen[$name]=$true;$list.Add($name)
+        if($list.Count -gt 200){throw '200 postes maximum par préparation de lot.'}
+    }
+    if(-not $list.Count){throw 'Collez au moins un nom de poste.'}
+    return $list.ToArray()
+}
+
+function New-GPBulkPlan {
+    param([string[]]$Names,[object[]]$Computers,[System.Data.DataTable]$Existing,
+          [string]$Prefix,[string]$Tag,[string]$Service,[string]$TargetOU,
+          [string]$Site,[string]$Organisme,[string]$TypeLetter='P',[bool]$KeepType=$true,[string]$Reference='')
+    if(-not $script:INDOMAIN){throw 'La préparation de lot est réservée aux postes du domaine.'}
+    if($Names.Count -lt 1 -or $Names.Count -gt 200){throw 'Entre 1 et 200 sources sont requises.'}
+    if($Prefix -notmatch '^\d{6}$' -or $Tag -notmatch '^[A-Za-z]{2}$' -or $Service -notmatch '^[A-Za-z0-9]{3}$' -or $TypeLetter -notin @('P','S')){throw 'Type, préfixe, tag ou service incorrect.'}
+    if(-not(Test-GPOUInConfiguredScope $TargetOU)){throw 'OU cible invalide ou hors périmètre.'}
+    if($Reference.Length -gt 120 -or $Reference -match '[\x00-\x1f\x7f]'){throw 'Référence invalide (120 caractères maximum, sans retours à la ligne).'}
+    $index=@{};$used=@{};$existingSources=@{};$seen=@{}
+    foreach($pc in @($Computers)) {
+        $name=([string]$pc.Name).Trim().ToUpperInvariant();if(-not $name){continue}
+        $used[$name]=$true
+        if(-not $index.ContainsKey($name)){$index[$name]=$pc}
+        elseif([string]$index[$name].DistinguishedName -ine [string]$pc.DistinguishedName){throw "Cache ambigu pour '$name'. Actualisez l'annuaire."}
+    }
+    foreach($row in @($Existing.Rows)) {
+        $existingSources[[string]$row.Nom_du_PC]=$true
+        if($row.Renommer -and $row.Nouveau_Nom){$used[[string]$row.Nouveau_Nom]=$true}
+    }
+    foreach($name in $Names) {
+        if(-not(Test-GPComputerName $name)){throw "Source invalide : '$name'."}
+        if($seen.ContainsKey($name) -or $existingSources.ContainsKey($name)){throw "Source dupliquée ou déjà présente dans la file : '$name'."}
+        $seen[$name]=$true;$used[$name]=$true
+        if(-not $index.ContainsKey($name)){throw "'$name' n'est pas dans le cache AD. Actualisez l'annuaire ou ajoutez ce poste individuellement."}
+    }
+    $candidate=New-QueueTable
+    foreach($name in $Names) {
+        $pc=$index[$name];$sourceOU=Get-GPParentDN ([string]$pc.DistinguishedName)
+        if(-not(Test-GPOUInConfiguredScope $sourceOU)){throw "Source hors périmètre : '$name'."}
+        $type=$TypeLetter
+        if($KeepType) {
+            if(-not(Test-GPGeneratedComputerName $name)){throw "Type non déductible du nom '$name'. Décochez 'Conserver le type' pour utiliser le type du formulaire."}
+            $type=$name.Substring(0,1).ToUpperInvariant()
+        }
+        $stem=($type+$Prefix+$Tag+$Service).ToUpperInvariant();$new=''
+        for($i=1;$i -le 999;$i++) {
+            $n=$stem+$i.ToString('000',[Globalization.CultureInfo]::InvariantCulture)
+            if(-not $used.ContainsKey($n)){$new=$n;$used[$n]=$true;break}
+        }
+        if(-not $new){throw "Plage 001-999 épuisée pour '$stem'. Aucun ajout partiel."}
+        $decision=Get-GPRenameMoveDecision -Computer $name -NewName $new -CurrentOU $sourceOU -TargetOU $TargetOU -Rename $true -Move $false
+        if(-not $decision.Valid){throw $decision.Error}
+        $r=$candidate.NewRow();$r.Nom_du_PC=$name;$r.Nouveau_Nom=$new;$r.OU_Actuelle=$sourceOU;$r.OU_Destination=$TargetOU
+        $r.Type_de_PC=switch($type){'P'{'Portable'};'S'{'Fixe'};'V'{'Virtuel'}}
+        $r.Organisme=$Organisme;$r.Site=$Site;$r.Service=$Service.ToUpperInvariant();$r.Renommer=$true;$r.Deplacer=[bool]$decision.Move
+        $r.Traiter=$false;$r.Reboot=$false;$r.Reference=$Reference.Trim();$r.Precontrole='À CONTRÔLER'
+        $guid=[Guid]::Empty
+        if([Guid]::TryParse([string]$pc.ObjectGUID,[ref]$guid) -and $guid -ne [Guid]::Empty){$r.Objet_GUID=$guid.ToString('D')}
+        $r.Plan=Get-GPRowPlanText -Row $r
+        [void]$candidate.Rows.Add($r)
+    }
+    if($Existing.Rows.Count+$candidate.Rows.Count -gt 5000){throw 'La file dépasserait 5 000 postes.'}
+    return ,$candidate
+}
